msgstr "Le raccourci n'est pas actif — ouvrez les Options avancées pour le corriger"

#, python-brace-format
msgid "Select text and press {key} to read it aloud"
msgstr "Sélectionnez du texte et appuyez sur {key} pour le lire à voix haute"

msgid "Show tray icon"
msgstr "Afficher l'icône dans la zone de notification"

msgid "Restore Defaults…"
msgstr "Restaurer les valeurs par défaut…"

msgid "Welcome"
msgstr "Bienvenue"

msgid "About BigLinux TTS"
msgstr "À propos de BigLinux TTS"

