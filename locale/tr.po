#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:244
msgid "Kokoro is not installed. Install the biglinux-kokoro-tts package."
msgstr "Kokoro kurulu değil. biglinux-kokoro-tts paketini kurun."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:246
msgid "The Kokoro voice model is missing. Reinstall the biglinux-kokoro-tts package."
msgstr "Kokoro ses modeli eksik. biglinux-kokoro-tts paketini yeniden kurun."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:248
msgid "No Kokoro voices were found. Open the Voice Manager to download a voice."
msgstr "Kokoro sesi bulunamadı. Ses indirmek için Ses Yöneticisi'ni açın."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:252
msgid "This Kokoro voice is not installed. Open the Voice Manager to download it."
msgstr "Bu Kokoro sesi kurulu değil. İndirmek için Ses Yöneticisi'ni açın."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:448
#, python-brace-format
msgid "Unknown voice: {voice_id}"
msgstr "Bilinmeyen ses: {voice_id}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:453
#, python-brace-format
msgid "Invalid voice id: {voice_id}"
msgstr "Geçersiz ses kimliği: {voice_id}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:474
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:486
msgid "The voice file is larger than expected."
msgstr "Ses dosyası beklenenden büyük."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:496
#, python-brace-format
msgid "incomplete download ({received} of {total} bytes)"
msgstr "eksik indirme ({received} / {total} bayt)"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:501
msgid "empty response"
msgstr "boş yanıt"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:507
#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "Ses indirilemedi. İnternet bağlantınızı denetleyip yeniden deneyin. ({error})"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:514
#, python-brace-format
msgid "The downloaded voice file is damaged. Try again. ({error})"
msgstr "İndirilen ses dosyası bozuk. Yeniden deneyin. ({error})"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:525
#, python-brace-format
msgid "Not enough disk space to install the voice ({size} MB needed)."
msgstr "Sesi kurmak için yeterli disk alanı yok ({size} MB gerekli)."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:533
#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "Kullanıcı sesleri dizini oluşturulamıyor: {error}"
