msgstr "Прочитати виділений текст або зупинити читання"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:244
msgid "Kokoro is not installed. Install the biglinux-kokoro-tts package."
msgstr "Kokoro не встановлено. Встановіть пакунок biglinux-kokoro-tts."

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:246
msgid "The Kokoro voice model is missing. Reinstall the biglinux-kokoro-tts package."
msgstr "Відсутня голосова модель Kokoro. Перевстановіть пакунок biglinux-kokoro-tts."

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:248
msgid "No Kokoro voices were found. Open the Voice Manager to download a voice."
msgstr "Голоси Kokoro не знайдено. Відкрийте менеджер голосів, щоб завантажити голос."

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:252
msgid "This Kokoro voice is not installed. Open the Voice Manager to download it."
msgstr "Цей голос Kokoro не встановлено. Відкрийте менеджер голосів, щоб завантажити його."

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:449
#, python-brace-format
msgid "Unknown voice: {voice_id}"
msgstr "Невідомий голос: {voice_id}"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:454
#, python-brace-format
msgid "Invalid voice id: {voice_id}"
msgstr "Неприпустимий ідентифікатор голосу: {voice_id}"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:475
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:487
msgid "The voice file is larger than expected."
msgstr "Файл голосу більший, ніж очікувалося."

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:497
#, python-brace-format
msgid "incomplete download ({received} of {total} bytes)"
msgstr "неповне завантаження ({received} з {total} байтів)"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:502
msgid "empty response"
msgstr "порожня відповідь"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:508
#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "Не вдалося завантажити голос. Перевірте з'єднання з інтернетом і спробуйте ще раз. ({error})"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:515
#, python-brace-format
msgid "The downloaded voice file is damaged. Try again. ({error})"
msgstr "Завантажений файл голосу пошкоджено. Спробуйте ще раз. ({error})"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:526
#, python-brace-format
msgid "Not enough disk space to install the voice ({size} MB needed)."
msgstr "Недостатньо місця на диску для встановлення голосу (потрібно {size} МБ)."

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:534
#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "Не вдалося створити каталог користувацьких голосів: {error}"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:540
#, python-brace-format
msgid "Failed to add voice: {error}"
msgstr "Не вдалося додати голос: {error}"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:553
msgid "Cannot remove base voice"
msgstr "Неможливо вилучити базовий голос"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:556
msgid "No user voices installed"
msgstr "Користувацькі голоси не встановлено"

#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:561
#, python-brace-format
msgid "Failed to remove voice: {error}"
msgstr "Не вдалося вилучити голос: {error}"

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:93
msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "Встановлення скасовано: пароль адміністратора не підтверджено."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:96
#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} недоступний у ваших репозиторіях. Оновіть систему (sudo pacman -Syu) і спробуйте ще раз."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:100
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:120
msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Інша програма встановлює або оновлює пакунки. Дочекайтеся її завершення і спробуйте ще раз."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:102
msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Не вдалося завантажити пакунки. Перевірте з'єднання з інтернетом і спробуйте ще раз."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:104
#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} конфліктує зі встановленими файлами або пакунками. Див. подробиці."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:106
#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "Недостатньо вільного місця на диску для встановлення {packages}."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:108
#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "Не вдалося встановити {packages}. Див. подробиці."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:116
msgid "Nothing to install."
msgstr "Нічого встановлювати."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:129
msgid "pkexec is not installed (package polkit)."
msgstr "pkexec не встановлено (пакунок polkit)."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:131
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:134
msgid "The installation took too long and was stopped."
msgstr "Встановлення тривало надто довго і було зупинено."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:120
msgid "This key combination is not valid."
msgstr "Ця комбінація клавіш недійсна."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:125
msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "Використовуйте Ctrl, Alt або Super разом із клавішею, щоб не заважати звичайному введенню тексту."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:226
msgid "This key combination is not supported by the desktop."
msgstr "Ця комбінація клавіш не підтримується робочим середовищем."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:238
#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut} уже використовується: {names}. Виберіть іншу комбінацію клавіш."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:257
msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "Робоче середовище не прийняло комбінацію клавіш. Чи запущено службу глобальних комбінацій клавіш KDE?"

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:263
msgid "The desktop did not confirm the new shortcut."
msgstr "Робоче середовище не підтвердило нову комбінацію клавіш."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:286
msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "Комбінацію клавіш збережено, але робоче середовище ще не змогло її підтвердити."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:298
msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "Не вдалося зареєструвати комбінацію клавіш у цьому робочому середовищі. Додайте її в системних налаштуваннях клавіатури з командою biglinux-tts-speak."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:129
msgid "Could not play audio. Check that alsa-utils (aplay) is installed."
msgstr "Не вдалося відтворити звук. Переконайтеся, що встановлено alsa-utils (aplay)."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:450
#, python-brace-format
msgid "{engine} could not start. Check that it is installed."
msgstr "Не вдалося запустити {engine}. Переконайтеся, що його встановлено."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:559
msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "RHVoice не встановлено. Встановіть пакунок rhvoice."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:641
msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "espeak-ng не зміг прочитати цей текст. Переконайтеся, що espeak-ng встановлено."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:753
msgid "The selected Piper voice is not installed. Choose another voice in the Voice Manager."
msgstr "Вибраний голос Piper не встановлено. Виберіть інший голос у менеджері голосів."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:803
msgid "Piper could not read this text. Try another voice."
msgstr "Piper не зміг прочитати цей текст. Спробуйте інший голос."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:1044
#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} аварійно завершив роботу під час читання тексту."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:1053
#, python-brace-format
msgid "{engine} stopped with an error and could not read the text."
msgstr "{engine} зупинився з помилкою і не зміг прочитати текст."

