msgstr "La voce Piper selezionata non è installata. Scegli un'altra voce nel Gestore voci."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:878
msgid "Piper could not read this text. Try another voice."
msgstr "Piper non è riuscito a leggere questo testo. Prova un'altra voce."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:1049
#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} si è bloccato durante la lettura del testo."

