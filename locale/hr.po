#: usr/share/biglinux/tts-biglinux/services/package_installer.py:93
msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "Instalacija je otkazana: administratorska lozinka nije potvrđena."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:96
#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} nije dostupno u vašim repozitorijima. Ažurirajte sustav (sudo pacman -Syu) i pokušajte ponovno."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:100
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:120
msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Drugi program instalira ili ažurira pakete. Pričekajte da završi i pokušajte ponovno."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:102
msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Paketi se nisu mogli preuzeti. Provjerite internetsku vezu i pokušajte ponovno."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:104
#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} je u sukobu s instaliranim datotekama ili paketima. Pogledajte pojedinosti."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:106
#, python-brace-format
msgid "Not enough free disk space to install {packages}."
