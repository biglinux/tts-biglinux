#, python-brace-format
msgid "Failed to remove voice: {error}"
msgstr "Ses kaldırılamadı: {error}"
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:93
msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "Kurulum iptal edildi: yönetici parolası onaylanmadı."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:96
#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} depolarınızda mevcut değil. Sistemi güncelleyin (sudo pacman -Syu) ve yeniden deneyin."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:100
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:120
msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Başka bir program paket kuruyor veya güncelliyor. Bitmesini bekleyip yeniden deneyin."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:102
msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Paketler indirilemedi. İnternet bağlantınızı denetleyip yeniden deneyin."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:104
#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages}, kurulu dosyalar veya paketlerle çakışıyor. Ayrıntılara bakın."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:106
#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "{packages} kurulumu için yeterli boş disk alanı yok."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:108
#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "{packages} kurulamadı. Ayrıntılara bakın."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:116
msgid "Nothing to install."
msgstr "Kurulacak bir şey yok."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:129
msgid "pkexec is not installed (package polkit)."
msgstr "pkexec kurulu değil (polkit paketi)."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:131
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:134
msgid "The installation took too long and was stopped."
msgstr "Kurulum çok uzun sürdü ve durduruldu."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:120
msgid "This key combination is not valid."
msgstr "Bu tuş birleşimi geçerli değil."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:125
msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "Normal yazmanın etkilenmemesi için Ctrl, Alt veya Super tuşunu başka bir tuşla birlikte kullanın."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:226
msgid "This key combination is not supported by the desktop."
msgstr "Bu tuş birleşimi masaüstü tarafından desteklenmiyor."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:238
#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut} zaten şunlar tarafından kullanılıyor: {names}. Başka bir kısayol seçin."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:257
msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "Masaüstü kısayolu kabul etmedi. KDE genel kısayollar hizmeti çalışıyor mu?"
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:263
msgid "The desktop did not confirm the new shortcut."
msgstr "Masaüstü yeni kısayolu onaylamadı."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:286
msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "Kısayol kaydedildi, ancak masaüstü henüz onaylayamadı."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:298
msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "Kısayol bu masaüstünde kaydedilemedi. biglinux-tts-speak komutuyla sistem klavye ayarlarına ekleyin."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:136
msgid "Could not play audio. Check that alsa-utils (aplay) is installed."
msgstr "Ses çalınamadı. alsa-utils (aplay) paketinin kurulu olduğunu denetleyin."
