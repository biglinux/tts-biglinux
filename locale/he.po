msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "לא ניתן היה לרשום את קיצור המקשים בשולחן עבודה זה. יש להוסיף אותו בהגדרות המקלדת של המערכת עם הפקודה biglinux-tts-speak."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:129
msgid "Could not play audio. Check that alsa-utils (aplay) is installed."
msgstr "לא ניתן היה לנגן שמע. יש לוודא ש־alsa-utils (aplay) מותקן."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:450
#, python-brace-format
msgid "{engine} could not start. Check that it is installed."
msgstr "לא ניתן היה להפעיל את {engine}. יש לוודא שהוא מותקן."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:559
msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "RHVoice אינו מותקן. יש להתקין את החבילה rhvoice."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:641
msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "espeak-ng לא הצליח להקריא טקסט זה. יש לוודא ש־espeak-ng מותקן."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:753
msgid "The selected Piper voice is not installed. Choose another voice in the Voice Manager."
msgstr "קול ה־Piper שנבחר אינו מותקן. יש לבחור קול אחר במנהל הקולות."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:803
msgid "Piper could not read this text. Try another voice."
msgstr "Piper לא הצליח להקריא טקסט זה. כדאי לנסות קול אחר."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:1044
#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} קרס במהלך הקראת הטקסט."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:1053
#, python-brace-format
