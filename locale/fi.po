msgstr "Globaali pikanäppäin"

#, python-brace-format
msgid ""
"Press {key} to read selected text\n"
"from any application"
msgstr ""
"Lue valittu teksti mistä tahansa\n"
"sovelluksesta painamalla {key}"

msgid "Clipboard Reading"
msgstr "Leikealueen lukeminen"

msgid ""
"Paste or type text directly\n"
"and listen instantly"
msgstr "Liitä tai kirjoita teksti suoraan ja kuuntele heti."

msgid "Fine-Tune Speech"
msgstr "Hienosäätää puhetta"

msgid ""
"Adjust speed, pitch and volume\n"
"to your preference"
msgstr "Säädä nopeus, sävelkorkeus ja äänenvoimakkuus mieltymystesi mukaan."

msgid "Easy Installation"
msgstr "Helppo asennus"

msgid ""
"Install new voices and engines\n"
"directly from the interface"
msgstr "Asenna uusia ääniä ja moottoreita suoraan käyttöliittymästä."

msgid "Neural Voices"
msgstr "Neuraalivaihteet"

msgid ""
"Install Piper or Kokoro voices for natural,\n"
"high-quality speech synthesis"
msgstr ""
"Asenna Piper- tai Kokoro-ääniä luonnollista,\n"
"laadukasta puhesynteesiä varten"

msgid "Reading History"
msgstr "Lukuhistoria"

msgid ""
"Optionally save and replay previous\n"
"readings when history is enabled"
msgstr ""
"Tallenna halutessasi aiemmat lukukerrat\n"
"ja toista niitä, kun historia on käytössä"

#, python-brace-format
msgid "Tip: Press {key} to read selected text from any application."
msgstr "Vinkki: Lue valittu teksti mistä tahansa sovelluksesta painamalla {key}."

msgid "Show dialog on startup"
msgstr "Näytä ikkuna käynnistyksessä"

msgid "Let's Start"
msgstr "Aloitetaan"

msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "Asennus peruttiin: ylläpitäjän salasanaa ei vahvistettu."

#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} ei ole saatavilla ohjelmistolähteissäsi. Päivitä järjestelmä (sudo pacman -Syu) ja yritä uudelleen."

msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Toinen ohjelma asentaa tai päivittää paketteja. Odota, että se valmistuu, ja yritä uudelleen."

msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Paketteja ei voitu ladata. Tarkista internetyhteys ja yritä uudelleen."

#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} on ristiriidassa asennettujen tiedostojen tai pakettien kanssa. Katso lisätiedot."

#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "Vapaata levytilaa ei ole tarpeeksi kohteen {packages} asentamiseen."

#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "Kohdetta {packages} ei voitu asentaa. Katso lisätiedot."

msgid "Nothing to install."
msgstr "Ei mitään asennettavaa."

msgid "pkexec is not installed (package polkit)."
msgstr "pkexec-ohjelmaa ei ole asennettu (polkit-paketti)."

msgid "The installation took too long and was stopped."
msgstr "Asennus kesti liian kauan ja pysäytettiin."

#, python-brace-format
msgid "{packages} could not be built from the AUR. See the details."
msgstr "Pakettia {packages} ei voitu kääntää AUR:sta. Katso lisätiedot."

msgid "This key combination is not valid."
msgstr "Tämä näppäinyhdistelmä ei kelpaa."

msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "Käytä Ctrl-, Alt- tai Super-näppäintä yhdessä toisen näppäimen kanssa, jotta tavallinen kirjoittaminen ei häiriinny."

msgid "This key combination is not supported by the desktop."
msgstr "Työpöytä ei tue tätä näppäinyhdistelmää."

#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut} on jo käytössä: {names}. Valitse toinen pikanäppäin."

msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "Työpöytä ei hyväksynyt pikanäppäintä. Onko KDE:n globaalien pikanäppäinten palvelu käynnissä?"

msgid "The desktop did not confirm the new shortcut."
msgstr "Työpöytä ei vahvistanut uutta pikanäppäintä."

msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "Pikanäppäin tallennettiin, mutta työpöytä ei voinut vielä vahvistaa sitä."

msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "Pikanäppäintä ei voitu rekisteröidä tällä työpöydällä. Lisää se järjestelmän näppäimistöasetuksiin komennolla biglinux-tts-speak."

msgid "Extra low quality"
msgstr "Erittäin matala laatu"

msgid "Low quality"
msgstr "Matala laatu"

msgid "Medium quality"
msgstr "Keskitasoinen laatu"

msgid "Kokoro is not installed. Install the biglinux-kokoro-tts package."
msgstr "Kokoro ei ole asennettuna. Asenna biglinux-kokoro-tts-paketti."

msgid "The Kokoro voice model is missing. Reinstall the biglinux-kokoro-tts package."
msgstr "Kokoron äänimalli puuttuu. Asenna biglinux-kokoro-tts-paketti uudelleen."

msgid "No Kokoro voices were found. Open the Voice Manager to download a voice."
msgstr "Kokoro-ääniä ei löytynyt. Lataa ääni avaamalla Äänten hallinta."

msgid "This Kokoro voice is not installed. Open the Voice Manager to download it."
msgstr "Tätä Kokoro-ääntä ei ole asennettu. Lataa se avaamalla Äänten hallinta."

#, python-brace-format
msgid "Unknown voice: {voice_id}"
msgstr "Tuntematon ääni: {voice_id}"

#, python-brace-format
msgid "Invalid voice id: {voice_id}"
msgstr "Virheellinen äänen tunniste: {voice_id}"

msgid "The voice file is larger than expected."
msgstr "Äänitiedosto on odotettua suurempi."

#, python-brace-format
msgid "incomplete download ({received} of {total} bytes)"
msgstr "keskeneräinen lataus ({received}/{total} tavua)"

msgid "empty response"
msgstr "tyhjä vastaus"

#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "Ääntä ei voitu ladata. Tarkista internetyhteys ja yritä uudelleen. ({error})"

#, python-brace-format
msgid "The downloaded voice file is damaged. Try again. ({error})"
msgstr "Ladattu äänitiedosto on vioittunut. Yritä uudelleen. ({error})"

#, python-brace-format
msgid "Not enough disk space to install the voice ({size} MB needed)."
msgstr "Levytilaa ei ole tarpeeksi äänen asentamiseen ({size} Mt tarvitaan)."

#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "Käyttäjän äänikansiota ei voi luoda: {error}"

