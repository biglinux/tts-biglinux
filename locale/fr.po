msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "L'installation a été annulée : le mot de passe administrateur n'a pas été confirmé."

#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} n'est pas disponible dans vos dépôts. Mettez à jour le système (sudo pacman -Syu) et réessayez."

msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Un autre programme installe ou met à jour des paquets. Attendez qu'il ait terminé et réessayez."

msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Impossible de télécharger les paquets. Vérifiez votre connexion Internet et réessayez."

#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} est en conflit avec des fichiers ou paquets installés. Consultez les détails."

#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "Espace disque libre insuffisant pour installer {packages}."

#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "Impossible d'installer {packages}. Consultez les détails."

msgid "Nothing to install."
msgstr "Rien à installer."

msgid "pkexec is not installed (package polkit)."
msgstr "pkexec n'est pas installé (paquet polkit)."

msgid "The installation took too long and was stopped."
msgstr "L'installation a pris trop de temps et a été interrompue."

#, python-brace-format
msgid "{packages} could not be built from the AUR. See the details."
msgstr "{packages} n'a pas pu être compilé depuis l'AUR. Consultez les détails."

msgid "This key combination is not valid."
msgstr "Cette combinaison de touches n'est pas valide."

msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "Utilisez Ctrl, Alt ou Super avec une touche, afin de ne pas gêner la saisie normale."

msgid "This key combination is not supported by the desktop."
msgstr "Cette combinaison de touches n'est pas prise en charge par le bureau."

#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut} est déjà utilisé par : {names}. Choisissez un autre raccourci."

msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "Le bureau n'a pas accepté le raccourci. Le service des raccourcis globaux de KDE est-il en cours d'exécution ?"

msgid "The desktop did not confirm the new shortcut."
msgstr "Le bureau n'a pas confirmé le nouveau raccourci."

msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "Le raccourci a été enregistré, mais le bureau n'a pas encore pu le confirmer."

msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "Impossible d'enregistrer le raccourci sur ce bureau. Ajoutez-le dans les paramètres clavier du système avec la commande biglinux-tts-speak."

msgid "Extra low quality"
msgstr "Qualité très faible"

msgid "Low quality"
msgstr "Qualité faible"

msgid "Medium quality"
msgstr "Qualité moyenne"

msgid "Kokoro is not installed. Install the biglinux-kokoro-tts package."
msgstr "Kokoro n'est pas installé. Installez le paquet biglinux-kokoro-tts."

msgid "The Kokoro voice model is missing. Reinstall the biglinux-kokoro-tts package."
msgstr "Le modèle vocal Kokoro est manquant. Réinstallez le paquet biglinux-kokoro-tts."

msgid "No Kokoro voices were found. Open the Voice Manager to download a voice."
msgstr "Aucune voix Kokoro trouvée. Ouvrez le gestionnaire de voix pour télécharger une voix."

msgid "This Kokoro voice is not installed. Open the Voice Manager to download it."
msgstr "Cette voix Kokoro n'est pas installée. Ouvrez le gestionnaire de voix pour la télécharger."

#, python-brace-format
msgid "Unknown voice: {voice_id}"
msgstr "Voix inconnue : {voice_id}"

#, python-brace-format
msgid "Invalid voice id: {voice_id}"
msgstr "Identifiant de voix non valide : {voice_id}"

msgid "The voice file is larger than expected."
msgstr "Le fichier de voix est plus volumineux que prévu."

#, python-brace-format
msgid "incomplete download ({received} of {total} bytes)"
msgstr "téléchargement incomplet ({received} sur {total} octets)"

msgid "empty response"
msgstr "réponse vide"

#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "Impossible de télécharger la voix. Vérifiez votre connexion Internet et réessayez. ({error})"

#, python-brace-format
msgid "The downloaded voice file is damaged. Try again. ({error})"
msgstr "Le fichier de voix téléchargé est endommagé. Réessayez. ({error})"

#, python-brace-format
msgid "Not enough disk space to install the voice ({size} MB needed)."
msgstr "Espace disque insuffisant pour installer la voix ({size} Mo nécessaires)."

#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "Impossible de créer le dossier des voix utilisateur : {error}"

#, python-brace-format
msgid "Failed to add voice: {error}"
msgstr "Échec de l'ajout de la voix : {error}"

msgid "Cannot remove base voice"
msgstr "Impossible de supprimer la voix de base"

msgid "No user voices installed"
msgstr "Aucune voix utilisateur installée"

#, python-brace-format
msgid "Failed to remove voice: {error}"
msgstr "Échec de la suppression de la voix : {error}"

msgid "Read or stop the selected text"
msgstr "Lire ou arrêter le texte sélectionné"

msgid "Could not play audio. Check that alsa-utils (aplay) is installed."
msgstr "Impossible de lire l'audio. Vérifiez que alsa-utils (aplay) est installé."

#, python-brace-format
msgid "{engine} could not start. Check that it is installed."
msgstr "{engine} n'a pas pu démarrer. Vérifiez qu'il est installé."

msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "RHVoice n'est pas installé. Installez le paquet rhvoice."

msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "espeak-ng n'a pas pu lire ce texte. Vérifiez que espeak-ng est installé."

msgid "The selected Piper voice is not installed. Choose another voice in the Voice Manager."
msgstr "La voix Piper sélectionnée n'est pas installée. Choisissez une autre voix dans le gestionnaire de voix."

msgid "Piper could not read this text. Try another voice."
msgstr "Piper n'a pas pu lire ce texte. Essayez une autre voix."

#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} a planté pendant la lecture du texte."

#, python-brace-format
msgid "{engine} stopped with an error and could not read the text."
msgstr "{engine} s'est arrêté avec une erreur et n'a pas pu lire le texte."

msgid "Read the selected text aloud"
msgstr "Lire à voix haute le texte sélectionné"

msgid "Could not read the text."
msgstr "Impossible de lire le texte."

msgid "Reading text"
msgstr "Lecture du texte"

msgid "Playing…"
msgstr "En train de jouer…"

msgid "Install wl-clipboard (Wayland) or xclip (X11) so selected text can be read."
msgstr "Installez wl-clipboard (Wayland) ou xclip (X11) pour que le texte sélectionné puisse être lu."

msgid "Select some text first, then press the shortcut."
msgstr "Sélectionnez d'abord du texte, puis appuyez sur le raccourci."

msgid "No text selected"
msgstr "Aucun texte sélectionné"

msgid "Read text"
msgstr "Lisez le texte"

msgid "Settings"
msgstr "Paramètres"

msgid "Quit"
msgstr "Quitter"

msgid "Paused"
msgstr "En pause"

msgid "BigLinux Team"
msgstr "Équipe BigLinux"

msgid "BigLinux TTS turns selected or typed text into speech with local voices, global shortcuts and precise playback controls."
msgstr "BigLinux TTS transforme le texte sélectionné ou saisi en parole avec des voix locales, des raccourcis globaux et des commandes de lecture précises."

msgid "BigLinux TTS began as a web-based tool in 2021 and evolved into a native GTK4 application with multiple speech engines, voice management and a Rust audio engine."
msgstr "BigLinux TTS a débuté en 2021 comme outil web et est devenu une application GTK4 native avec plusieurs moteurs vocaux, une gestion des voix et un moteur audio en Rust."

msgid "Could not register the shortcut."
msgstr "Impossible d'enregistrer le raccourci."

#, python-brace-format
msgid "Select text and press {shortcut} to hear it"
msgstr "Sélectionnez du texte et appuyez sur {shortcut} pour l'écouter"

