#, python-brace-format
msgid "Failed to add voice: {error}"
msgstr "Ses eklenemedi: {error}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:552
msgid "Cannot remove base voice"
msgstr "Temel ses kaldırılamaz"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:555
msgid "No user voices installed"
msgstr "Kurulu kullanıcı sesi yok"
