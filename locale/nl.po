msgid "Let's Start"
msgstr "Laten we beginnen"

msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "De installatie is geannuleerd: het beheerderswachtwoord is niet bevestigd."

#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} is niet beschikbaar in uw repository's. Werk het systeem bij (sudo pacman -Syu) en probeer het opnieuw."

msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Een ander programma is pakketten aan het installeren of bijwerken. Wacht tot het klaar is en probeer het opnieuw."

msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "De pakketten konden niet worden gedownload. Controleer uw internetverbinding en probeer het opnieuw."

#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} conflicteert met geïnstalleerde bestanden of pakketten. Zie de details."

#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "Onvoldoende vrije schijfruimte om {packages} te installeren."

#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "{packages} kon niet worden geïnstalleerd. Zie de details."

msgid "Nothing to install."
msgstr "Niets te installeren."

msgid "pkexec is not installed (package polkit)."
msgstr "pkexec is niet geïnstalleerd (pakket polkit)."

msgid "The installation took too long and was stopped."
msgstr "De installatie duurde te lang en is gestopt."

#, python-brace-format
msgid "{packages} could not be built from the AUR. See the details."
msgstr "{packages} kon niet vanuit de AUR worden gebouwd. Zie de details."

msgid "This key combination is not valid."
msgstr "Deze toetscombinatie is ongeldig."

msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "Gebruik Ctrl, Alt of Super samen met een toets, zodat normaal typen niet wordt beïnvloed."

msgid "This key combination is not supported by the desktop."
msgstr "Deze toetscombinatie wordt niet ondersteund door de desktop."

#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut} wordt al gebruikt door: {names}. Kies een andere sneltoets."

msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "De desktop heeft de sneltoets niet geaccepteerd. Draait de KDE-dienst voor globale sneltoetsen?"

msgid "The desktop did not confirm the new shortcut."
msgstr "De desktop heeft de nieuwe sneltoets niet bevestigd."

msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "De sneltoets is opgeslagen, maar de desktop kon hem nog niet bevestigen."

msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "Kan de sneltoets niet registreren op deze desktop. Voeg hem toe in de toetsenbordinstellingen van het systeem met de opdracht biglinux-tts-speak."

msgid "Extra low quality"
msgstr "Zeer lage kwaliteit"

msgid "Low quality"
msgstr "Lage kwaliteit"

msgid "Medium quality"
msgstr "Gemiddelde kwaliteit"

msgid "Kokoro is not installed. Install the biglinux-kokoro-tts package."
msgstr "Kokoro is niet geïnstalleerd. Installeer het pakket biglinux-kokoro-tts."

msgid "The Kokoro voice model is missing. Reinstall the biglinux-kokoro-tts package."
msgstr "Het Kokoro-stemmodel ontbreekt. Installeer het pakket biglinux-kokoro-tts opnieuw."

msgid "No Kokoro voices were found. Open the Voice Manager to download a voice."
msgstr "Geen Kokoro-stemmen gevonden. Open Stembeheer om een stem te downloaden."

msgid "This Kokoro voice is not installed. Open the Voice Manager to download it."
msgstr "Deze Kokoro-stem is niet geïnstalleerd. Open Stembeheer om hem te downloaden."

#, python-brace-format
msgid "Unknown voice: {voice_id}"
msgstr "Onbekende stem: {voice_id}"

#, python-brace-format
msgid "Invalid voice id: {voice_id}"
msgstr "Ongeldige stem-ID: {voice_id}"

msgid "The voice file is larger than expected."
msgstr "Het stembestand is groter dan verwacht."

#, python-brace-format
msgid "incomplete download ({received} of {total} bytes)"
msgstr "onvolledige download ({received} van {total} bytes)"

msgid "empty response"
msgstr "leeg antwoord"

#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "Kan de stem niet downloaden. Controleer uw internetverbinding en probeer het opnieuw. ({error})"

#, python-brace-format
msgid "The downloaded voice file is damaged. Try again. ({error})"
msgstr "Het gedownloade stembestand is beschadigd. Probeer het opnieuw. ({error})"

#, python-brace-format
msgid "Not enough disk space to install the voice ({size} MB needed)."
msgstr "Onvoldoende schijfruimte om de stem te installeren ({size} MB nodig)."

#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "Kan de map voor gebruikersstemmen niet aanmaken: {error}"

#, python-brace-format
msgid "Failed to add voice: {error}"
msgstr "Kan stem niet toevoegen: {error}"

msgid "Cannot remove base voice"
msgstr "Kan basisstem niet verwijderen"

msgid "No user voices installed"
msgstr "Geen gebruikersstemmen geïnstalleerd"

#, python-brace-format
msgid "Failed to remove voice: {error}"
msgstr "Kan stem niet verwijderen: {error}"

msgid "Read or stop the selected text"
msgstr "Geselecteerde tekst voorlezen of stoppen"

msgid "Could not play audio. Check that alsa-utils (aplay) is installed."
msgstr "Kan audio niet afspelen. Controleer of alsa-utils (aplay) is geïnstalleerd."

#, python-brace-format
msgid "{engine} could not start. Check that it is installed."
msgstr "{engine} kon niet starten. Controleer of het is geïnstalleerd."

msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "RHVoice is niet geïnstalleerd. Installeer het pakket rhvoice."

msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "espeak-ng kon deze tekst niet lezen. Controleer of espeak-ng is geïnstalleerd."

msgid "The selected Piper voice is not installed. Choose another voice in the Voice Manager."
msgstr "De geselecteerde Piper-stem is niet geïnstalleerd. Kies een andere stem in Stembeheer."

msgid "Piper could not read this text. Try another voice."
msgstr "Piper kon deze tekst niet lezen. Probeer een andere stem."

#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} is gecrasht tijdens het lezen van de tekst."

#, python-brace-format
msgid "{engine} stopped with an error and could not read the text."
msgstr "{engine} is gestopt met een fout en kon de tekst niet lezen."

msgid "Read the selected text aloud"
msgstr "De geselecteerde tekst voorlezen"

msgid "Could not read the text."
msgstr "Kan de tekst niet lezen."

msgid "Reading text"
msgstr "Tekst wordt gelezen"

msgid "Playing…"
msgstr "Spelen…"

msgid "Install wl-clipboard (Wayland) or xclip (X11) so selected text can be read."
msgstr "Installeer wl-clipboard (Wayland) of xclip (X11) zodat geselecteerde tekst kan worden gelezen."

msgid "Select some text first, then press the shortcut."
msgstr "Selecteer eerst tekst en druk dan op de sneltoets."

msgid "No text selected"
msgstr "Geen tekst geselecteerd"

msgid "Read text"
msgstr "Lees tekst"

msgid "Settings"
msgstr "Instellingen"

msgid "Quit"
msgstr "Afsluiten"

msgid "Paused"
msgstr "Gepauzeerd"

msgid "BigLinux Team"
msgstr "BigLinux-team"

msgid "BigLinux TTS turns selected or typed text into speech with local voices, global shortcuts and precise playback controls."
msgstr "BigLinux TTS zet geselecteerde of getypte tekst om in spraak met lokale stemmen, globale sneltoetsen en nauwkeurige afspeelbediening."

msgid "BigLinux TTS began as a web-based tool in 2021 and evolved into a native GTK4 application with multiple speech engines, voice management and a Rust audio engine."
msgstr "BigLinux TTS begon in 2021 als webtool en groeide uit tot een native GTK4-toepassing met meerdere spraakengines, stembeheer en een audio-engine in Rust."

msgid "Could not register the shortcut."
msgstr "Kan de sneltoets niet registreren."

#, python-brace-format
msgid "Select text and press {shortcut} to hear it"
msgstr "Selecteer tekst en druk op {shortcut} om ernaar te luisteren"

