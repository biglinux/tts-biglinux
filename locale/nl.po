#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "Kan de map voor gebruikersstemmen niet aanmaken: {error}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:539
#, python-brace-format
msgid "Failed to add voice: {error}"
msgstr "Kan stem niet toevoegen: {error}"
