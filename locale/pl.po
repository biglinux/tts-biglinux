#: usr/share/biglinux/tts-biglinux/application.py:647
msgid "Playing…"
msgstr "Graję…"
#: usr/share/biglinux/tts-biglinux/application.py:513
msgid "Install wl-clipboard (Wayland) or xclip (X11) so selected text can be read."
msgstr "Zainstaluj wl-clipboard (Wayland) lub xclip (X11), aby można było odczytywać zaznaczony tekst."
#: usr/share/biglinux/tts-biglinux/application.py:518
msgid "Select some text first, then press the shortcut."
msgstr "Najpierw zaznacz tekst, a następnie naciśnij skrót klawiszowy."
#: usr/share/biglinux/tts-biglinux/application.py:519
msgid "No text selected"
msgstr "Nie zaznaczono tekstu"
#: usr/share/biglinux/tts-biglinux/application.py:612
msgid "Read text"
msgstr "Przeczytaj tekst"
#: usr/share/biglinux/tts-biglinux/application.py:618
#: usr/share/biglinux/tts-biglinux/ui/audio_player.py:89
#: usr/share/biglinux/tts-biglinux/ui/audio_player.py:144
#: usr/share/biglinux/tts-biglinux/ui/audio_player.py:181
msgid "Play"
msgstr "Graj"
