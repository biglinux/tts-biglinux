#: usr/share/biglinux/tts-biglinux/application.py:718
msgid "BigLinux TTS turns selected or typed text into speech with local voices, global shortcuts and precise playback controls."
msgstr "BigLinux TTS převádí vybraný nebo napsaný text na řeč pomocí místních hlasů, globálních klávesových zkratek a přesného ovládání přehrávání."

#: usr/share/biglinux/tts-biglinux/application.py:721
msgid "BigLinux TTS began as a web-based tool in 2021 and evolved into a native GTK4 application with multiple speech engines, voice management and a Rust audio engine."
msgstr "BigLinux TTS vznikl v roce 2021 jako webový nástroj a vyvinul se v nativní aplikaci GTK4 s několika řečovými enginy, správou hlasů a zvukovým enginem v jazyce Rust."

#: usr/share/biglinux/tts-biglinux/application.py:773
msgid "Could not register the shortcut."
msgstr "Klávesovou zkratku nelze zaregistrovat."

#: usr/share/biglinux/tts-biglinux/application.py:799
#, python-brace-format
msgid "Select text and press {shortcut} to hear it"
msgstr "Vyberte text a stiskněte {shortcut}, abyste jej slyšeli"

#: usr/share/biglinux/tts-biglinux/application.py:800
msgid "Text-to-speech assistant"
msgstr "Asistent pro převod textu na řeč"

#: usr/share/biglinux/tts-biglinux/main.py:17
msgid "BigLinux Text-to-Speech — Read selected text aloud"
msgstr "BigLinux Text-to-Speech — čtení vybraného textu nahlas"

#: usr/share/biglinux/tts-biglinux/main.py:22
