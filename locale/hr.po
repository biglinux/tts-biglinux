msgid "{packages} could not be built from the AUR. See the details."
msgstr "{packages} nije moguće izgraditi iz AUR-a. Pogledajte pojedinosti."

msgid "Read or stop the selected text"
msgstr "Pročitaj ili zaustavi odabrani tekst"

