msgid "{engine} could not start. Check that it is installed."
msgstr "{engine} ei käynnistynyt. Tarkista, että se on asennettu."

msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "RHVoice ei ole asennettuna. Asenna rhvoice-paketti."

msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "espeak-ng ei voinut lukea tätä tekstiä. Tarkista, että espeak-ng on asennettu."

msgid "The selected Piper voice is not installed. Choose another voice in the Voice Manager."
msgstr "Valittua Piper-ääntä ei ole asennettu. Valitse toinen ääni Äänten hallinnassa."

msgid "Piper could not read this text. Try another voice."
msgstr "Piper ei voinut lukea tätä tekstiä. Kokeile toista ääntä."

#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} kaatui tekstiä luettaessa."

#, python-brace-format
