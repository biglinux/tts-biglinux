msgstr "Не вдалося зберегти аудіо"
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:285
#: usr/share/biglinux/tts-biglinux/window.py:288
#: usr/share/biglinux/tts-biglinux/window.py:377
msgid "History"
msgstr "Історія"
