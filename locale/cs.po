#, python-brace-format
msgid "Select text and press {key} to read it aloud"
msgstr "Vyberte text a stiskněte {key} pro přečtení nahlas"

msgid "History"
msgstr "Historie"

msgid "Loading voice…"
msgstr "Načítání hlasu…"

