#: usr/share/biglinux/tts-biglinux/window.py:390
msgid "Quit"
msgstr "יציאה"
#: usr/share/biglinux/tts-biglinux/application.py:647
msgid "Paused"
msgstr "מושהה"
#: usr/share/biglinux/tts-biglinux/application.py:718
msgid "BigLinux Team"
msgstr "צוות BigLinux"
#: usr/share/biglinux/tts-biglinux/application.py:729
msgid "BigLinux TTS turns selected or typed text into speech with local voices, global shortcuts and precise playback controls."
msgstr "BigLinux TTS הופך טקסט נבחר או מוקלד לדיבור באמצעות קולות מקומיים, קיצורי מקשים גלובליים ובקרות השמעה מדויקות."
#: usr/share/biglinux/tts-biglinux/application.py:732
msgid "BigLinux TTS began as a web-based tool in 2021 and evolved into a native GTK4 application with multiple speech engines, voice management and a Rust audio engine."
msgstr "BigLinux TTS התחיל ב־2021 ככלי מבוסס רשת והתפתח ליישום GTK4 מקורי עם מספר מנועי דיבור, ניהול קולות ומנוע שמע הכתוב ב־Rust."
#: usr/share/biglinux/tts-biglinux/application.py:784
msgid "Could not register the shortcut."
msgstr "לא ניתן היה לרשום את קיצור המקשים."
#: usr/share/biglinux/tts-biglinux/application.py:810
#, python-brace-format
msgid "Select text and press {shortcut} to hear it"
msgstr "יש לבחור טקסט וללחוץ על {shortcut} כדי לשמוע אותו"
#: usr/share/biglinux/tts-biglinux/application.py:811
msgid "Text-to-speech assistant"
msgstr "עוזר טקסט לדיבור"
#: usr/share/biglinux/tts-biglinux/main.py:24
msgid "BigLinux Text-to-Speech — Read selected text aloud"
msgstr "BigLinux טקסט לדיבור — הקראת הטקסט הנבחר בקול"
#: usr/share/biglinux/tts-biglinux/main.py:29
msgid "Enable debug logging"
msgstr "הפעלת רישום ניפוי שגיאות"
#: usr/share/biglinux/tts-biglinux/services/desktop_integration_service.py:305
#: usr/share/biglinux/tts-biglinux/services/desktop_integration_service.py:359
msgid "Read or stop the selected text"
msgstr "הקראה או עצירה של הטקסט הנבחר"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:244
msgid "Kokoro is not installed. Install the biglinux-kokoro-tts package."
msgstr "Kokoro אינו מותקן. יש להתקין את החבילה biglinux-kokoro-tts."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:246
msgid "The Kokoro voice model is missing. Reinstall the biglinux-kokoro-tts package."
msgstr "מודל הקול של Kokoro חסר. יש להתקין מחדש את החבילה biglinux-kokoro-tts."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:248
msgid "No Kokoro voices were found. Open the Voice Manager to download a voice."
msgstr "לא נמצאו קולות Kokoro. יש לפתוח את מנהל הקולות כדי להוריד קול."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:252
msgid "This Kokoro voice is not installed. Open the Voice Manager to download it."
msgstr "קול Kokoro זה אינו מותקן. יש לפתוח את מנהל הקולות כדי להוריד אותו."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:448
#, python-brace-format
msgid "Unknown voice: {voice_id}"
msgstr "קול לא ידוע: {voice_id}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:453
#, python-brace-format
msgid "Invalid voice id: {voice_id}"
msgstr "מזהה קול לא תקין: {voice_id}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:474
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:486
msgid "The voice file is larger than expected."
msgstr "קובץ הקול גדול מהצפוי."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:496
#, python-brace-format
msgid "incomplete download ({received} of {total} bytes)"
msgstr "הורדה חלקית ({received} מתוך {total} בתים)"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:501
msgid "empty response"
msgstr "תגובה ריקה"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:507
#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "לא ניתן היה להוריד את הקול. יש לבדוק את החיבור לאינטרנט ולנסות שוב. ({error})"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:514
#, python-brace-format
msgid "The downloaded voice file is damaged. Try again. ({error})"
msgstr "קובץ הקול שהורד פגום. נא לנסות שוב. ({error})"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:525
#, python-brace-format
msgid "Not enough disk space to install the voice ({size} MB needed)."
msgstr "אין מספיק מקום בכונן להתקנת הקול (נדרשים {size} MB)."
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:533
#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "לא ניתן ליצור את תיקיית קולות המשתמש: {error}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:539
#, python-brace-format
msgid "Failed to add voice: {error}"
msgstr "הוספת הקול נכשלה: {error}"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:552
msgid "Cannot remove base voice"
msgstr "לא ניתן להסיר את קול הבסיס"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:555
msgid "No user voices installed"
msgstr "אין קולות משתמש מותקנים"
#: usr/share/biglinux/tts-biglinux/services/kokoro_voice_service.py:560
#, python-brace-format
msgid "Failed to remove voice: {error}"
msgstr "הסרת הקול נכשלה: {error}"
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:93
msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "ההתקנה בוטלה: ססמת המנהל לא אושרה."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:96
#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} אינו זמין במאגרים שלך. יש לעדכן את המערכת (sudo pacman -Syu) ולנסות שוב."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:100
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:120
msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "תוכנית אחרת מתקינה או מעדכנת חבילות. יש להמתין לסיומה ולנסות שוב."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:102
msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "לא ניתן היה להוריד את החבילות. יש לבדוק את החיבור לאינטרנט ולנסות שוב."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:104
#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} מתנגש עם קבצים או חבילות מותקנים. ניתן לעיין בפרטים."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:106
#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "אין מספיק מקום פנוי בכונן להתקנת {packages}."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:108
#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "לא ניתן היה להתקין את {packages}. ניתן לעיין בפרטים."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:116
msgid "Nothing to install."
msgstr "אין מה להתקין."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:129
msgid "pkexec is not installed (package polkit)."
msgstr "pkexec אינו מותקן (החבילה polkit)."
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:131
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:134
msgid "The installation took too long and was stopped."
msgstr "ההתקנה ארכה זמן רב מדי ונעצרה."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:120
msgid "This key combination is not valid."
msgstr "צירוף מקשים זה אינו תקין."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:125
msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "יש להשתמש ב־Ctrl, Alt או Super יחד עם מקש נוסף, כדי שההקלדה הרגילה לא תושפע."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:226
msgid "This key combination is not supported by the desktop."
msgstr "צירוף מקשים זה אינו נתמך על ידי שולחן העבודה."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:238
#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut} כבר בשימוש על ידי: {names}. יש לבחור קיצור מקשים אחר."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:257
msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "שולחן העבודה לא קיבל את קיצור המקשים. האם שירות קיצורי המקשים הגלובליים של KDE פועל?"
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:263
msgid "The desktop did not confirm the new shortcut."
msgstr "שולחן העבודה לא אישר את קיצור המקשים החדש."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:286
msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "קיצור המקשים נשמר, אך שולחן העבודה עדיין לא הצליח לאשר אותו."
#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:298
msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "לא ניתן היה לרשום את קיצור המקשים בשולחן עבודה זה. יש להוסיף אותו בהגדרות המקלדת של המערכת עם הפקודה biglinux-tts-speak."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:136
msgid "Could not play audio. Check that alsa-utils (aplay) is installed."
msgstr "לא ניתן היה לנגן שמע. יש לוודא ש־alsa-utils (aplay) מותקן."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:473
#, python-brace-format
msgid "{engine} could not start. Check that it is installed."
msgstr "לא ניתן היה להפעיל את {engine}. יש לוודא שהוא מותקן."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:607
msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "RHVoice אינו מותקן. יש להתקין את החבילה rhvoice."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:813
msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "espeak-ng לא הצליח להקריא טקסט זה. יש לוודא ש־espeak-ng מותקן."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:828
msgid "The selected Piper voice is not installed. Choose another voice in the Voice Manager."
msgstr "קול ה־Piper שנבחר אינו מותקן. יש לבחור קול אחר במנהל הקולות."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:878
msgid "Piper could not read this text. Try another voice."
msgstr "Piper לא הצליח להקריא טקסט זה. כדאי לנסות קול אחר."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:1049
#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} קרס במהלך הקראת הטקסט."
#: usr/share/biglinux/tts-biglinux/services/tts_service.py:1051
#, python-brace-format
msgid "{engine} stopped with an error and could not read the text."
msgstr "{engine} נעצר עם שגיאה ולא הצליח להקריא את הטקסט."
#: usr/share/biglinux/tts-biglinux/services/voice_manager.py:607
