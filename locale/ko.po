msgid "BigLinux Text-to-Speech — Read selected text aloud"
msgstr "BigLinux 텍스트 음성 변환 — 선택한 텍스트를 소리 내어 읽기"

msgid "Enable debug logging"
msgstr "디버그 로그 사용"

msgid "Settings"
msgstr "설정"

msgid "Show settings"
msgstr "설정 표시"

msgid "Back"
msgstr "뒤로"

msgid "Text narrator"
msgstr "텍스트 낭독기"

msgid "The shortcut is not active — open Advanced options to fix it"
msgstr "단축키가 활성화되지 않았습니다 — 고급 옵션을 열어 해결하세요"

#, python-brace-format
msgid "Select text and press {key} to read it aloud"
msgstr "텍스트를 선택하고 {key} 키를 눌러 소리 내어 읽기"

msgid "History"
msgstr "기록"

msgid "Loading voice…"
msgstr "음성 불러오는 중…"

msgid "Speaking…"
msgstr "읽는 중…"

msgid "Could not read the text"
msgstr "텍스트를 읽을 수 없습니다"

msgid "Show tray icon"
msgstr "트레이 아이콘 표시"

msgid "Restore Defaults…"
msgstr "기본값 복원…"

msgid "Welcome"
msgstr "환영합니다"

msgid "About BigLinux TTS"
msgstr "BigLinux TTS 정보"

msgid "Quit"
msgstr "종료"

msgid "Main menu"
msgstr "기본 메뉴"

msgid "Restore settings?"
msgstr "설정을 복원하시겠습니까?"

msgid "This will return all adjustments to their original defaults."
msgstr "모든 조정이 원래 기본값으로 돌아갑니다."

msgid "Cancel"
msgstr "취소"

msgid "Restore"
msgstr "복원"

msgid "This key combination is not valid."
msgstr "유효하지 않은 키 조합입니다."

msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "일반 입력에 영향을 주지 않도록 Ctrl, Alt 또는 Super를 다른 키와 함께 사용하세요."

msgid "This key combination is not supported by the desktop."
msgstr "데스크톱에서 지원하지 않는 키 조합입니다."

#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut}은(는) 이미 사용 중입니다: {names}. 다른 단축키를 선택하세요."

msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "데스크톱이 단축키를 받아들이지 않았습니다. KDE 전역 단축키 서비스가 실행 중인가요?"

msgid "The desktop did not confirm the new shortcut."
msgstr "데스크톱이 새 단축키를 확인하지 않았습니다."

msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "단축키가 저장되었지만 데스크톱에서 아직 확인하지 못했습니다."

msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "이 데스크톱에서 단축키를 등록할 수 없습니다. 시스템 키보드 설정에서 biglinux-tts-speak 명령으로 추가하세요."

msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "설치가 취소되었습니다: 관리자 암호가 확인되지 않았습니다."

#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages}을(를) 저장소에서 사용할 수 없습니다. 시스템을 업데이트(sudo pacman -Syu)한 후 다시 시도하세요."

msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "다른 프로그램이 패키지를 설치하거나 업데이트하고 있습니다. 완료될 때까지 기다린 후 다시 시도하세요."

msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "패키지를 다운로드할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하세요."

#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages}이(가) 설치된 파일 또는 패키지와 충돌합니다. 자세한 내용을 확인하세요."

#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "{packages}을(를) 설치할 디스크 여유 공간이 부족합니다."

#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "{packages}을(를) 설치할 수 없습니다. 자세한 내용을 확인하세요."

msgid "Nothing to install."
msgstr "설치할 항목이 없습니다."

msgid "pkexec is not installed (package polkit)."
msgstr "pkexec가 설치되어 있지 않습니다(polkit 패키지)."

msgid "The installation took too long and was stopped."
msgstr "설치 시간이 너무 오래 걸려 중지되었습니다."

#, python-brace-format
msgid "{packages} could not be built from the AUR. See the details."
msgstr "AUR에서 {packages}을(를) 빌드할 수 없습니다. 세부 정보를 확인하세요."

msgid "Read or stop the selected text"
msgstr "선택한 텍스트 읽기 또는 중지"

msgid "Kokoro is not installed. Install the biglinux-kokoro-tts package."
msgstr "Kokoro가 설치되어 있지 않습니다. biglinux-kokoro-tts 패키지를 설치하세요."

msgid "The Kokoro voice model is missing. Reinstall the biglinux-kokoro-tts package."
msgstr "Kokoro 음성 모델이 없습니다. biglinux-kokoro-tts 패키지를 다시 설치하세요."

msgid "No Kokoro voices were found. Open the Voice Manager to download a voice."
msgstr "Kokoro 음성을 찾을 수 없습니다. 음성 관리자를 열어 음성을 다운로드하세요."

msgid "This Kokoro voice is not installed. Open the Voice Manager to download it."
msgstr "이 Kokoro 음성은 설치되어 있지 않습니다. 음성 관리자를 열어 다운로드하세요."

#, python-brace-format
msgid "Unknown voice: {voice_id}"
msgstr "알 수 없는 음성: {voice_id}"

#, python-brace-format
msgid "Invalid voice id: {voice_id}"
msgstr "잘못된 음성 ID: {voice_id}"

msgid "The voice file is larger than expected."
msgstr "음성 파일이 예상보다 큽니다."

#, python-brace-format
msgid "incomplete download ({received} of {total} bytes)"
msgstr "다운로드가 완료되지 않음({total}바이트 중 {received}바이트)"

msgid "empty response"
msgstr "빈 응답"

#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "음성을 다운로드할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하세요. ({error})"

#, python-brace-format
msgid "The downloaded voice file is damaged. Try again. ({error})"
msgstr "다운로드한 음성 파일이 손상되었습니다. 다시 시도하세요. ({error})"

#, python-brace-format
msgid "Not enough disk space to install the voice ({size} MB needed)."
msgstr "음성을 설치할 디스크 공간이 부족합니다({size} MB 필요)."

#, python-brace-format
msgid "Cannot create user voices directory: {error}"
msgstr "사용자 음성 디렉터리를 만들 수 없음: {error}"

#, python-brace-format
msgid "Failed to add voice: {error}"
msgstr "음성을 추가하지 못함: {error}"

msgid "Cannot remove base voice"
msgstr "기본 음성은 제거할 수 없음"

msgid "No user voices installed"
msgstr "설치된 사용자 음성 없음"

#, python-brace-format
msgid "Failed to remove voice: {error}"
msgstr "음성을 제거하지 못함: {error}"

msgid "Could not play audio. Check that alsa-utils (aplay) is installed."
msgstr "오디오를 재생할 수 없습니다. alsa-utils(aplay)가 설치되어 있는지 확인하세요."

#, python-brace-format
msgid "{engine} could not start. Check that it is installed."
msgstr "{engine}을(를) 시작할 수 없습니다. 설치되어 있는지 확인하세요."

msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "RHVoice가 설치되어 있지 않습니다. rhvoice 패키지를 설치하세요."

msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "espeak-ng가 이 텍스트를 읽을 수 없습니다. espeak-ng가 설치되어 있는지 확인하세요."

msgid "The selected Piper voice is not installed. Choose another voice in the Voice Manager."
msgstr "선택한 Piper 음성이 설치되어 있지 않습니다. 음성 관리자에서 다른 음성을 선택하세요."

msgid "Piper could not read this text. Try another voice."
msgstr "Piper가 이 텍스트를 읽을 수 없습니다. 다른 음성을 사용해 보세요."

#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "텍스트를 읽는 중 {engine}이(가) 비정상 종료되었습니다."

#, python-brace-format
msgid "{engine} stopped with an error and could not read the text."
msgstr "{engine}이(가) 오류로 중지되어 텍스트를 읽을 수 없습니다."

msgid "Extra low quality"
msgstr "매우 낮은 품질"

msgid "Low quality"
msgstr "낮은 품질"

msgid "Medium quality"
msgstr "중간 품질"

msgid "High quality"
msgstr "높은 품질"

