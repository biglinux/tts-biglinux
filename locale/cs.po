msgstr "Vybraný hlas Piper není nainstalován. Zvolte jiný hlas ve Správci hlasů."

msgid "Piper could not read this text. Try another voice."
msgstr "Piper nemohl přečíst tento text. Zkuste jiný hlas."

#, python-brace-format
msgid "{engine} crashed while reading the text."
msgstr "{engine} během čtení textu spadl."

#, python-brace-format
msgid "{engine} stopped with an error and could not read the text."
msgstr "{engine} se zastavil s chybou a nemohl přečíst text."

