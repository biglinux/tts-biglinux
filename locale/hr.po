msgstr "Nema ništa za instalirati."

msgid "pkexec is not installed (package polkit)."
msgstr "pkexec nije instaliran (paket polkit)."

msgid "The installation took too long and was stopped."
msgstr "Instalacija je trajala predugo i zaustavljena je."

