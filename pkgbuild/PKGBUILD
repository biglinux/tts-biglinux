# Maintainer: Bruno Goncalves <bigbruno@gmail.com>

pkgname=tts-biglinux
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
license=('GPL')
url="https://github.com/biglinux/tts-biglinux"
pkgdesc="Read selected text aloud with a global shortcut — RHVoice, espeak-ng, Piper and Kokoro voices"
depends=(
    # Application runtime
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita>=1:1.5'         # Adw.AlertDialog, Adw.OverlaySplitView, Adw.Breakpoint
    'python-numpy'              # Kokoro voice downloads (.pt → .npy conversion)
    'polkit'                    # pkexec: install/remove voice packages
    # Native engine (tts_engine.so, built here)
    'onnxruntime'               # Piper ONNX inference (system library, dynamic link)
    'espeak-ng'                 # espeak voices + Piper phonemizer (linked by tts_engine.so)
    # Audio
    'alsa-utils'                # aplay: every engine plays through it
    'sox'                       # volume control on the subprocess fallback paths
    'gstreamer'                 # History player (playbin)
    'gst-plugins-base'
    'gst-plugins-good'          # wavparse + audio sinks for the History player
    # Default voice engine, ready out of the box (Brazilian Portuguese)
    'rhvoice'
    'rhvoice-voice-leticia-f123'
    'rhvoice-brazilian-portuguese-complementary-dict-biglinux'
    'speech-dispatcher'         # python speechd module; legacy speech-dispatcher voices
    # Selected-text capture
    'wl-clipboard-rs'           # Wayland (wl-paste)
    'xsel'                      # X11
    # System tray icon (enabled by default) and media controls
    'pyside6'
    'qt6-svg'                   # the tray icons are SVG
)
makedepends=(
    'git'
    'rust>=1.85'
    'cargo'
)
checkdepends=(
    'python-pytest'
)
optdepends=(
    'biglinux-kokoro-tts: Kokoro neural voices (koko engine, model and base voices)'
    'piper-tts-bin: Piper command-line fallback (the native engine needs only voices)'
    'piper-voices-pt-BR: Brazilian Portuguese neural voices for Piper'
    'rhvoice-voice-evgeniy-eng: RHVoice English male voice'
    'xclip: selection capture on X11 when xsel is not available'
    'python-kokoro: alternative Kokoro engine (PyTorch based)'
    'python-pytorch: PyTorch runtime for python-kokoro'
    'python-soundfile: audio file I/O for python-kokoro'
)
source=("git+https://github.com/biglinux/tts-biglinux.git")
md5sums=(SKIP)

build() {
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        _basedir="${srcdir}/${pkgname}/${pkgname}"
    else
        _basedir="${srcdir}/${pkgname}"
    fi

    # Build native Rust TTS engine.
    # --locked: honor Cargo.lock so the ONNX Runtime binding (ort) can't be
    # silently re-resolved to a version incompatible with the system
    # onnxruntime (this exact drift previously broke the .so at runtime).
    # ORT_LIB_LOCATION/ORT_PREFER_DYNAMIC_LINK: link against the system
    # /usr/lib/libonnxruntime.so, never a pip-provided one.
    if [ -d "${_basedir}/tts-engine" ]; then
        cd "${_basedir}/tts-engine"
        ORT_LIB_LOCATION=/usr/lib ORT_PREFER_DYNAMIC_LINK=1 \
            cargo build --release --locked
    fi
}

check() {
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        _basedir="${srcdir}/${pkgname}/${pkgname}"
    else
        _basedir="${srcdir}/${pkgname}"
    fi
    cd "${_basedir}/tts-engine"
    ORT_LIB_LOCATION=/usr/lib ORT_PREFER_DYNAMIC_LINK=1 cargo test --release --locked
    # Offline, headless tests (GTK widget tests skip without a display).
    # No bytecode: package() copies usr/ afterwards and must not ship
    # __pycache__ files that embed $srcdir paths.
    cd "${_basedir}"
    PYTHONDONTWRITEBYTECODE=1 python -m pytest -q -p no:cacheprovider tests
}

package() {
    # Verify default folder
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    else
        InternalDir="${srcdir}/${pkgname}"
    fi

    # Install usr/ tree (bin, share/biglinux, share/applications, share/icons, share/locale, share/khotkeys)
    if [ -d "${InternalDir}/usr" ]; then
        cp -r "${InternalDir}/usr" "${pkgdir}/usr"
    fi

    # Never ship bytecode caches (from check() or a dirty tree).
    find "${pkgdir}/usr" -type d -name __pycache__ -prune -exec rm -rf {} +

    # Install native Rust TTS engine
    local _so="${InternalDir}/tts-engine/target/release/libtts_engine.so"
    if [ -f "$_so" ]; then
        install -Dm755 "$_so" \
            "${pkgdir}/usr/share/biglinux/tts-biglinux/tts_engine.so"
    fi

    # Fix permissions for executables
    if [ -d "${pkgdir}/usr/bin" ]; then
        chmod 755 "${pkgdir}/usr/bin/"*
    fi

    # Install .po translation files
    if [ -d "${InternalDir}/locale" ]; then
        install -d "${pkgdir}/usr/share/tts-biglinux/locale"
        install -m644 "${InternalDir}/locale/"*.po \
            "${pkgdir}/usr/share/tts-biglinux/locale/"
    fi

    # Icon compatibility symlink (old name → new name)
    mkdir -p "${pkgdir}/usr/share/icons/hicolor/scalable/apps/"
    if [ -f "${pkgdir}/usr/share/icons/hicolor/scalable/apps/biglinux-tts.svg" ] && \
       [ ! -f "${pkgdir}/usr/share/icons/hicolor/scalable/apps/tts-biglinux.svg" ]; then
        ln -s "biglinux-tts.svg" \
            "${pkgdir}/usr/share/icons/hicolor/scalable/apps/tts-biglinux.svg"
    fi
}
