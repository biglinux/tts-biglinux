msgid "Turn On"
msgstr "Увімкнути"
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:328
msgid "Search text, voice, engine or date…"
msgstr "Пошук за текстом, голосом, рушієм або датою…"
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:335
msgid "All dates"
msgstr "Усі дати"
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:335
msgid "Today"
msgstr "Сьогодні"
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:335
msgid "Yesterday"
msgstr "Учора"
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:335
msgid "Last 7 days"
msgstr "Останні 7 днів"
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:337
#: usr/share/biglinux/tts-biglinux/ui/history_view.py:338
