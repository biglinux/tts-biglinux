msgstr "Ova kombinacija tipki nije valjana."

msgid "Use Ctrl, Alt or Super together with a key, so normal typing is not affected."
msgstr "Koristite Ctrl, Alt ili Super zajedno s nekom tipkom kako ne bi utjecali na uobičajeno tipkanje."

msgid "This key combination is not supported by the desktop."
msgstr "Radno okruženje ne podržava ovu kombinaciju tipki."

#, python-brace-format
msgid "{shortcut} is already used by: {names}. Choose another shortcut."
msgstr "{shortcut} već koristi: {names}. Odaberite drugi prečac."

msgid "The desktop did not accept the shortcut. Is the KDE global shortcuts service running?"
msgstr "Radno okruženje nije prihvatilo prečac. Je li pokrenuta KDE usluga globalnih prečaca?"

msgid "The desktop did not confirm the new shortcut."
msgstr "Radno okruženje nije potvrdilo novi prečac."

msgid "The shortcut was saved, but the desktop could not confirm it yet."
msgstr "Prečac je spremljen, ali ga radno okruženje još nije moglo potvrditi."

msgid "Could not register the shortcut on this desktop. Add it in the system keyboard settings with the command biglinux-tts-speak."
msgstr "Prečac nije moguće registrirati u ovom radnom okruženju. Dodajte ga u postavkama tipkovnice sustava s naredbom biglinux-tts-speak."

msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "Instalacija je otkazana: administratorska lozinka nije potvrđena."

#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} nije dostupno u vašim repozitorijima. Ažurirajte sustav (sudo pacman -Syu) i pokušajte ponovno."

msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Drugi program instalira ili ažurira pakete. Pričekajte da završi i pokušajte ponovno."

msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Paketi se nisu mogli preuzeti. Provjerite internetsku vezu i pokušajte ponovno."

#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} je u sukobu s instaliranim datotekama ili paketima. Pogledajte pojedinosti."

#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "Nema dovoljno slobodnog prostora na disku za instalaciju paketa {packages}."

