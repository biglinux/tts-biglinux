msgid "incomplete download ({received} of {total} bytes)"
msgstr "neúplné stahování ({received} z {total} bajtů)"

msgid "empty response"
msgstr "prázdná odpověď"

#, python-brace-format
msgid "Could not download the voice. Check your internet connection and try again. ({error})"
msgstr "Hlas nelze stáhnout. Zkontrolujte připojení k internetu a zkuste to znovu. ({error})"

